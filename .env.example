# Bind address. Use 0.0.0.0 only when you need external access.
AITB_HOST=127.0.0.1
AITB_PORT=8787

# Fixed bootstrap token. Leave empty to auto-generate and persist in ~/.ai-terminal-bridge/token
# This token always has admin scope and cannot be revoked through the API.
AITB_TOKEN=

# Where managed (static / ephemeral) tokens are persisted
AITB_TOKENS_FILE=

# Audit log: file path and retention. Records older than N days are pruned every hour.
AITB_AUDIT_FILE=
AITB_AUDIT_MAX_AGE_DAYS=30

# Shell and default working directory
AITB_SHELL=/bin/bash
AITB_CWD=/workspace

# Session limits
AITB_MAX_SESSIONS=8
AITB_SESSION_IDLE_MS=1800000

# Connection lifecycle: close sessions with no connection for N minutes,
# purge dead sessions unattended for N days
AITB_CONN_IDLE_KILL_MINUTES=60
AITB_CONN_PURGE_DAYS=3

# Token lifetime limits
# AITB_DEFAULT_TTL_MS=3600000
# AITB_MAX_TTL_MS=2592000000

AITB_CORS=*
